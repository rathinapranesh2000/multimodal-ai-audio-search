# ==========================================
# AudioRAG Environment Configuration
# ==========================================

# PostgreSQL / Supabase
DATABASE_URL=

# Google Gemini
GOOGLE_API_KEY=

# Groq fallback
GROQ_API_KEY=

# Hugging Face
HF_TOKEN=

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Speed: known language and speaker count skip detection passes
WHISPER_LANGUAGE=en
DIARIZATION_NUM_SPEAKERS=2

# Optional model overrides
# GEMINI_MODEL=gemini-2.0-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# WHISPER_MODEL=small
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173